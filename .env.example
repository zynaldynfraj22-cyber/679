# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase configuration overrides (defaults come from firebase-applet-config.json)
FIREBASE_PROJECT_ID=""
FIREBASE_FIRESTORE_DATABASE_ID=""

# Transitional bootstrap admin email (must have verified email in Firebase Auth).
# Long-term authorization relies on Firebase custom claims (admin: true) and Firestore /admins/{uid}.
BOOTSTRAP_ADMIN_EMAIL=""

# Optional path to Google Cloud service account credentials for local self-hosted Node environments
# (Never commit service account JSON keys to the repository).
GOOGLE_APPLICATION_CREDENTIALS=""
